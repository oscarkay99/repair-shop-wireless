# Include this exact-match route in the staging API nginx server first.
# Replace the proxy target/include directives with the ones already used by
# that server; do not paste an unverified upstream name into production.
#
# Paystack's published webhook IPs (verified 2026-09-20):
# https://paystack.com/docs/payments/webhooks/
location = /functions/v1/paystack-webhook {
    allow 52.31.139.75;
    allow 52.49.173.169;
    allow 52.214.14.220;
    deny all;

    # Preserve the real peer address for the Edge Function's second allowlist.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # Use the staging server's existing Supabase/Kong upstream configuration.
    # proxy_pass http://kong;
}
